<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://kunal.home/CleanHome" version="1.0.0" viewmodes="maximized">
    <tizen:application id="KsHome0001.CleanHome" package="KsHome0001" required_version="2.3"/>
    <name>Clean Home</name>
    <description>Ad-free launcher: HDMI, YouTube, Netflix, ZEE5, Prime Video, JioHotstar, Sony LIV, Internet.</description>
    <author>Kunal S</author>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:profile name="tv-samsung"/>

    <!-- Launch other apps and read the installed-app list (used to auto-detect app IDs) -->
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <!-- Remote control keys (colour buttons, number keys) -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- Show an HDMI input inside the app (TVWindow API) -->
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/system"/>
    <tizen:privilege name="http://tizen.org/privilege/fullscreen"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
    <access origin="*" subdomains="true"/>
</widget>
